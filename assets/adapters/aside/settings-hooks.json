{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(aside *)",
            "timeout": 60,
            "statusMessage": "Aside 기동 확인 중(창 포커스 유지)...",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/00-meta/scripts/aside-up.ps1\" -Hook"
          },
          {
            "type": "command",
            "if": "PowerShell(aside *)",
            "timeout": 60,
            "statusMessage": "Aside 기동 확인 중(창 포커스 유지)...",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/00-meta/scripts/aside-up.ps1\" -Hook"
          }
        ]
      }
    ]
  }
}
