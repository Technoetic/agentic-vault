#!/bin/sh
# agentic-vault pre-commit 무결성 게이트 (lint 축약판, fail-closed)
#
# 스테이징된 .md 파일만 검사한다:
#   [규칙 A] 지식 구역(00-meta 직속·20-knowledge·30-journal·40-people·50-projects)
#            노트는 YAML 프런트매터(첫 줄 '---')가 필수다.
#   [규칙 B] 프런트매터 안의 위키링크는 반드시 이중 따옴표로 감싼다.
#            따옴표 없는 [[ ]]는 YAML 오파싱으로 Dataview를 붕괴시킨다.
#   [규칙 C] 지식 구역 노트를 삭제할 때 백링크가 남아 있으면 차단한다.
#            근거: 블로그 파일 1개를 교체하는 커밋이 무관한 노트 11개(3,848줄)를
#            함께 지웠고 index는 갱신되지 않아 죽은 링크 18건이 생겼다.
#            기존 규칙 A/B는 --diff-filter=ACM이라 삭제를 아예 보지 못했다.
#
# 검사 대상은 워킹트리가 아니라 **스테이징된 내용**(git show :파일)이다.
# 구역을 커스터마이즈하려면 아래 case 패턴을 수정하라.
# 전체 검증: /vault-lint  /  명시 우회(비권장): git commit --no-verify

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.md')
# 규칙 C는 삭제만 있는 커밋에서도 돌아야 한다.
# ACM만 보고 조기 종료하면 '삭제 전용 커밋'이 게이트를 통째로 우회한다(사고 재현 조건).
# core.quotepath=false 필수: 켜져 있으면 비ASCII 파일명이 \353\262… 로 깨져 basename이 무의미해진다.
deleted=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=D -- '*.md')
[ -z "$files" ] && [ -z "$deleted" ] && exit 0

fail=0
IFS='
'
for f in $files; do
  # ---- 규칙 A: 프런트매터 필수 구역 판정 ----
  need_fm=0
  case "$f" in
    00-meta/scratch/*|00-meta/scripts/*) need_fm=0 ;;
    10-inbox/*) need_fm=0 ;;
    00-meta/*|20-knowledge/*|30-journal/*|40-people/*|50-projects/*) need_fm=1 ;;
  esac

  first=$(git show ":$f" 2>/dev/null | head -n 1 | tr -d '\r' | sed 's/^\xef\xbb\xbf//')
  if [ "$need_fm" = "1" ] && [ "$first" != "---" ]; then
    echo "🚫 [pre-commit] 프런트매터 누락: $f" >&2
    echo "   지식 구역의 모든 노트는 YAML 프런트매터로 시작해야 합니다 (스키마: 00-meta/schemas/frontmatter.md)." >&2
    fail=1
  fi

  # ---- 규칙 B: 프런트매터 내 따옴표 없는 위키링크 ----
  if [ "$first" = "---" ]; then
    fm=$(git show ":$f" | tr -d '\r' | awk 'NR==1{next} /^---$/{exit} {print}')
    bad=$(printf '%s\n' "$fm" | sed 's/"\[\[//g' | sed "s/'\[\[//g" | grep -n '\[\[')
    if [ -n "$bad" ]; then
      echo "🚫 [pre-commit] 프런트매터에 따옴표 없는 위키링크: $f" >&2
      printf '%s\n' "$bad" | sed 's/^/   → 프런트매터 내부 /' >&2
      echo '   반드시 related: ["[[노트 이름]]"] 형태로 감싸세요 — 따옴표 없으면 YAML 오파싱으로 시스템 붕괴.' >&2
      fail=1
    fi
  fi
done

# ---- 규칙 C: 노트 삭제 시 백링크 잔존 차단 ----
# 판정 원천은 워킹트리가 아니라 '이 커밋이 만들 트리'(=인덱스)다.
# 따라서 같은 커밋에서 백링크를 함께 지우면 정상 통과한다 — 그것이 올바른 삭제 절차다.
if [ -n "$deleted" ]; then
  # append-only·자동생성 레지스트리는 참조자에서 제외한다.
  # 근거(실측): 제외해도 차단 건수가 변하지 않으면서, '감사 로그를 고쳐야만 통과 가능'한
  # 규약 충돌을 없앤다. 값은 vault-config.json에서 읽고, 없으면 기본값을 쓴다.
  cfgv() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
      00-meta/vault-config.json 2>/dev/null | head -n 1
  }
  skip_log=$(cfgv log_note);      [ -z "$skip_log" ]    && skip_log="00-meta/log.md"
  skip_health=$(cfgv health_report); [ -z "$skip_health" ] && skip_health="00-meta/health-report.md"

  for f in $deleted; do
    # 구역 판정: 규칙 A(프런트매터)보다 넓다.
    # 어느 폴더에 있든 참조되는 노트를 지우면 죽은 링크가 생기므로, 임시 구역만 제외한다.
    # (10-inbox는 정제 후 _processed로 옮기는 것이 정상 흐름이라 제외한다)
    case "$f" in
      00-meta/scratch/*|00-meta/scripts/*|10-inbox/*) continue ;;
      *) ;;
    esac

    stem=$(basename "$f" .md)
    esc=$(printf '%s' "$stem" | sed 's/[][\\.^$*+?(){}|\/]/\\&/g')
    # 4형태 모두 매칭: [[X]] · [[X|별칭]] · [[X#앵커]] · [[폴더/X]]
    pat="\[\[([^]|#]*\/)?$esc([|#][^]]*)?\]\]"

    # --cached는 반드시 패턴 '앞'에 온다. 뒤에 두면 git이 리비전으로 해석해 fatal이 나고,
    # 에러를 삼키면 게이트가 조용히 무력화된다(빈 결과 = 통과). 에러는 삼키지 않는다.
    refs=$(git -c core.quotepath=false grep --cached -lIE "$pat" -- '*.md' \
           | grep -v -x -F "$f" \
           | grep -v -x -F "$skip_log" \
           | grep -v -x -F "$skip_health")

    if [ -n "$refs" ]; then
      echo "🚫 [pre-commit] 삭제하려는 노트에 백링크가 남아 있습니다: $f" >&2
      printf '%s\n' "$refs" | sed 's/^/   ← 참조 중: /' >&2
      echo "   위 파일에서 [[$stem]] 링크를 먼저 정리한 뒤 같은 커밋에 함께 담으세요." >&2
      fail=1
    fi
  done
fi

if [ "$fail" = "1" ]; then
  echo "" >&2
  echo "커밋이 차단되었습니다. 위 노트를 수정한 뒤 다시 커밋하세요. (전체 검증: /vault-lint, 명시 우회: --no-verify)" >&2
  exit 1
fi
exit 0
