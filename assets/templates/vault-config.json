{
  "vault_name": "{{VAULT_NAME}}",
  "language": "ko",
  "deny_zones": ["10-inbox/_processed", "20-knowledge/_archive", "50-projects/_completed", "90-assets", ".obsidian"],
  "exclude_dirs": ["node_modules", ".venv", "venv", "__pycache__", ".git", ".trash", "step_archive"],
  "frontmatter_roots": ["00-meta", "20-knowledge", "30-journal", "40-people", "50-projects"],
  "frontmatter_exempt_paths": ["00-meta/scratch", "00-meta/scripts", "10-inbox"],
  "required_keys": ["title", "type", "status", "ai_priority", "tags", "created", "updated"],
  "enums": {
    "type": ["concept", "guide", "reference", "tool", "pattern", "journal", "person", "organization", "meeting", "decision", "project"],
    "status": ["active", "draft", "archive"],
    "ai_priority": ["high", "medium", "low", "archive"]
  },
  "frontmatter_max_lines": 16,
  "index_note": "00-meta/index.md",
  "log_note": "00-meta/log.md",
  "log_tags": ["ingest", "query", "lint", "build", "ops", "decision"],
  "log_tag_epoch": "{{DATE}}",
  "hot_note": "00-meta/hot.md",
  "handoff_note": "",
  "ssot_note": "",
  "ssot_facts": [],
  "health_report": "00-meta/health-report.md",
  "backup_target": "",
  "rules_dir": ".claude/rules",
  "rules_max_lines": 120,
  "hot_max_tokens": 2500,
  "handoff_max_tokens": 4000,
  "jarvis": {
    "enabled": false,
    "telegram_user_ids": [],
    "briefing_times": ["07:30"],
    "butler_interval_hours": 24,
    "qa_hourly_limit": 6,
    "qa_timeout_sec": 180,
    "claude_cmd": "claude"
  },
  "gates": {
    "note_create": { "confirm": false },
    "note_move": { "confirm": false, "log": true, "note": "격리 이동은 파일명을 바꾸지 않는다 — 위키링크가 파일명 기반이다" },
    "note_delete": { "confirm": true, "log": true, "note": "삭제는 되돌릴 수 없다. 아카이브 이동을 먼저 검토한다" },
    "lesson_promote": { "repeat": 3, "confirm": true, "probation_days": 14, "note": "3회 반복 관측 전 제안 금지 · 자동 승격 금지 · 수습 기간 내 롤백 가능해야 한다" },
    "git_commit": { "confirm": false, "log": true },
    "git_push_local": { "confirm": false },
    "git_push_remote": { "deny": true, "note": "네트워크 원격 push 는 사용자 승인 전 금지 — pre-push 훅이 강제한다" },
    "external_send": { "confirm": true, "log": true, "note": "볼트 밖으로 내용을 보내는 모든 행위(게시·메일·외부 API)" }
  }
}
