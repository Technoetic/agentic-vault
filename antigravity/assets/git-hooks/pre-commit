#!/bin/sh
# agentic-vault:hook engine=0.8.2
# 설치된 staged 검사기만 실행하고 그 종료 코드를 그대로 전달한다.

SCRIPT="$(dirname "$0")/../vault_healthcheck.py"

supports_python() {
  "$@" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' \
    >/dev/null 2>&1
}

if command -v python >/dev/null 2>&1 && supports_python python; then
  PYTHON_KIND=python
elif command -v python3 >/dev/null 2>&1 && supports_python python3; then
  PYTHON_KIND=python3
elif command -v py >/dev/null 2>&1 && supports_python py -3; then
  PYTHON_KIND=py
else
  echo "🚫 [pre-commit] python을 찾을 수 없습니다 — 작동하는 Python 3.10+ 필요." >&2
  exit 1
fi

[ -f "$SCRIPT" ] || {
  echo "🚫 [pre-commit] staged 검사기 없음: $SCRIPT" >&2
  exit 1
}

case "$PYTHON_KIND" in
  python) python "$SCRIPT" --vault . --staged ;;
  python3) python3 "$SCRIPT" --vault . --staged ;;
  py) py -3 "$SCRIPT" --vault . --staged ;;
esac
exit $?
